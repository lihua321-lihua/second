# --- 数据库（Postgres，本地与生产统一）---
# 运行时连接：Supabase「Transaction pooler」（6543 + pgbouncer=true）
DATABASE_URL="postgresql://postgres.<project-ref>:<密码>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# 迁移/建表连接：Supabase「Direct connection」（5432，无 pgbouncer），prisma migrate / db push 使用
DIRECT_URL="postgresql://postgres.<project-ref>:<密码>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# 注意：Netlify 部署时需在后台 Environment variables 中同时配置 DATABASE_URL 与 DIRECT_URL

# --- AI（可选，演示流程在没有 key 时走确定性规则引擎回退）---
# 支持 OpenAI 或任意 OpenAI 兼容端点（例如 DeepSeek）
# 配置后 AI 对话优先走 LLM 意图解析；未配置 key 或调用失败时自动回退确定性规则引擎
OPENAI_API_KEY=""
# 默认已指向 DeepSeek；换用其他 OpenAI 兼容服务时改这里
OPENAI_BASE_URL="https://api.deepseek.com/v1"
# DeepSeek 对话模型：deepseek-chat（V3）；推理场景可换 deepseek-reasoner
OPENAI_MODEL="deepseek-chat"

# --- 电子签 Mock ---
# auto  = 发起签署 3 秒后自动模拟双方签署完成并触发 Webhook
# manual = 需要手动点击"模拟签署完成"按钮
ESIGN_AUTO_COMPLETE="auto"

# --- 文件存储目录（服务端本地落盘，PDF 生成后可预览/下载） ---
UPLOAD_DIR="public/uploads"

# --- Mock Webhook 签名密钥（真实 provider 时用于验签） ---
ESIGN_WEBHOOK_SECRET="mock-secret"
